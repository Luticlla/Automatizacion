<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Autonorte_ASIS" targetNamespace="http://upao.edu.pe/aip/g4" exporter="Grupo 4 AIP" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Part_Cliente" name="Cliente" processRef="Proc_Cliente" />
    <bpmn:participant id="Part_Autonorte" name="Autonorte Servicios Automotrices S.A.C. | Atender solicitud de cita de mantenimiento preventivo" processRef="Proc_1" />
    <bpmn:messageFlow id="MF1" name="Solicitud de cita" sourceRef="C_T1" targetRef="Start_1" />
    <bpmn:messageFlow id="MF2" name="Aviso de derivación" sourceRef="T5" targetRef="C_T2" />
    <bpmn:messageFlow id="MF3" name="Fechas alternativas" sourceRef="T7" targetRef="C_T3" />
    <bpmn:messageFlow id="MF4" name="Respuesta del cliente" sourceRef="C_T5" targetRef="IC_msg" />
    <bpmn:messageFlow id="MF5" name="Nueva fecha propuesta" sourceRef="T13" targetRef="C_T7" />
    <bpmn:messageFlow id="MF6" name="Confirmación de la cita" sourceRef="T17" targetRef="C_T6" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Cliente" name="Cliente" isExecutable="false">
    <bpmn:startEvent id="C_Start" name="Necesita mantenimiento preventivo">
      <bpmn:outgoing>CF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="C_T1" name="Enviar la solicitud de cita">
      <bpmn:incoming>CF1</bpmn:incoming>
      <bpmn:outgoing>CF2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="C_GM" name="">
      <bpmn:incoming>CF2</bpmn:incoming>
      <bpmn:incoming>CF10</bpmn:incoming>
      <bpmn:outgoing>CF3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="C_G1" name="Espera la respuesta del taller">
      <bpmn:incoming>CF3</bpmn:incoming>
      <bpmn:outgoing>CF4</bpmn:outgoing>
      <bpmn:outgoing>CF5</bpmn:outgoing>
      <bpmn:outgoing>CF6</bpmn:outgoing>
      <bpmn:outgoing>CF7</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="C_T2" name="Recibir el aviso de derivación a reparaciones">
      <bpmn:incoming>CF4</bpmn:incoming>
      <bpmn:outgoing>CF11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="C_T3" name="Recibir las fechas alternativas">
      <bpmn:incoming>CF5</bpmn:incoming>
      <bpmn:outgoing>CF8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="C_T4" name="Elegir una de las fechas propuestas">
      <bpmn:incoming>CF8</bpmn:incoming>
      <bpmn:outgoing>CF9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="C_T5" name="Responder al asesor con la fecha elegida">
      <bpmn:incoming>CF9</bpmn:incoming>
      <bpmn:outgoing>CF10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_T6" name="Recibir la confirmación de la cita">
      <bpmn:incoming>CF6</bpmn:incoming>
      <bpmn:outgoing>CF13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="C_T7" name="Recibir la nueva fecha propuesta">
      <bpmn:incoming>CF7</bpmn:incoming>
      <bpmn:outgoing>CF12</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="C_End1" name="Cliente informado de la derivación">
      <bpmn:incoming>CF11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C_End2" name="Cliente con la cita confirmada">
      <bpmn:incoming>CF13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C_End3" name="Cliente informado de la reprogramación">
      <bpmn:incoming>CF12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CF1" sourceRef="C_Start" targetRef="C_T1" />
    <bpmn:sequenceFlow id="CF2" sourceRef="C_T1" targetRef="C_GM" />
    <bpmn:sequenceFlow id="CF3" sourceRef="C_GM" targetRef="C_G1" />
    <bpmn:sequenceFlow id="CF4" sourceRef="C_G1" targetRef="C_T2" />
    <bpmn:sequenceFlow id="CF5" sourceRef="C_G1" targetRef="C_T3" />
    <bpmn:sequenceFlow id="CF6" sourceRef="C_G1" targetRef="C_T6" />
    <bpmn:sequenceFlow id="CF7" sourceRef="C_G1" targetRef="C_T7" />
    <bpmn:sequenceFlow id="CF8" sourceRef="C_T3" targetRef="C_T4" />
    <bpmn:sequenceFlow id="CF9" sourceRef="C_T4" targetRef="C_T5" />
    <bpmn:sequenceFlow id="CF10" sourceRef="C_T5" targetRef="C_GM" />
    <bpmn:sequenceFlow id="CF11" sourceRef="C_T2" targetRef="C_End1" />
    <bpmn:sequenceFlow id="CF12" sourceRef="C_T7" targetRef="C_End3" />
    <bpmn:sequenceFlow id="CF13" sourceRef="C_T6" targetRef="C_End2" />
  </bpmn:process>
  <bpmn:process id="Proc_1" name="Atender solicitud de cita de mantenimiento preventivo" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Asesor" name="Asesor de servicio">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_t48</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T16</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T17</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Almacen" name="Almacén de repuestos">
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_err</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Jefe" name="Jefe de taller">
        <bpmn:flowNodeRef>IC_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T15</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DS1" name="Cuaderno de recepción" />
    <bpmn:dataStoreReference id="DS2" name="Historial de servicios (Excel)" />
    <bpmn:dataStoreReference id="DS3" name="Cuadro de programación semanal" />
    <bpmn:startEvent id="Start_1" name="Solicitud de cita recibida">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_1_def" />
    </bpmn:startEvent>
    <bpmn:manualTask id="T1" name="Anotar la solicitud en el cuaderno de recepción">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T1">
        <bpmn:targetRef>DS1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:userTask id="T2" name="Buscar el vehículo en el historial de servicios">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:property id="T2_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_T2">
        <bpmn:sourceRef>DS2</bpmn:sourceRef>
        <bpmn:targetRef>T2_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="¿Vehículo registrado?">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T3" name="Registrar al cliente y su vehículo">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1b" name="">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="Identificar el tipo de mantenimiento según el kilometraje">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="¿Es mantenimiento preventivo?">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T6" name="Consultar el cuadro de programación semanal">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:sendTask id="T5" name="Informar al cliente la derivación a reparaciones">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_1" name="Solicitud derivada a taller correctivo">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G3" name="¿Hay cupo en la fecha solicitada?">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T7" name="Proponer fechas alternativas al cliente">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G4" name="¿Responde o vence el plazo?">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="IC_msg" name="Respuesta del cliente recibida">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="IC_msg_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T7b" name="Acordar una fecha con cupo disponible">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="IC_t48" name="Vencen 48 horas sin respuesta del cliente">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IC_t48_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T8" name="Registrar la solicitud como desistida">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_2" name="Solicitud desistida">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G3b" name="">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T9" name="Solicitar al almacén la verificación del kit">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IC_t1" name="Espera de la respuesta del almacén">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IC_t1_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6H10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T10" name="Revisar la existencia del kit en el sistema de almacén">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5" name="¿Hay kit disponible?">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T11" name="Solicitar el kit al proveedor">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IC_t2" name="Espera de la llegada del kit">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IC_t2_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T12" name="Verificar la recepción del kit">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G5b" name="">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T13" name="Reprogramar la cita con el cliente">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_3" name="Cita reprogramada por falta de kit">
      <bpmn:incoming>F32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="T14" name="Informar la disponibilidad al asesor">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="IC_t3" name="Espera de la aprobación del jefe de taller">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IC_t3_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4H5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T15" name="Asignar la bahía y el técnico disponibles">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="T16" name="Registrar la cita en el cuadro de programación semanal">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_T16">
        <bpmn:targetRef>DS3</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:sendTask id="T17" name="Enviar la confirmación de la cita al cliente">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_4" name="Cita confirmada y programada">
      <bpmn:incoming>F38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BE_err" name="El proveedor no entrega el kit en el plazo" attachedToRef="T12">
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BE_err_def" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="G1" />
    <bpmn:sequenceFlow id="F4" name="No" sourceRef="G1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" name="Sí" sourceRef="G1" targetRef="G1b" />
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="G1b" />
    <bpmn:sequenceFlow id="F7" sourceRef="G1b" targetRef="T4" />
    <bpmn:sequenceFlow id="F8" sourceRef="T4" targetRef="G2" />
    <bpmn:sequenceFlow id="F9" name="Sí" sourceRef="G2" targetRef="T6" />
    <bpmn:sequenceFlow id="F10" name="No, es correctivo" sourceRef="G2" targetRef="T5" />
    <bpmn:sequenceFlow id="F11" sourceRef="T5" targetRef="End_1" />
    <bpmn:sequenceFlow id="F12" sourceRef="T6" targetRef="G3" />
    <bpmn:sequenceFlow id="F13" name="Sí" sourceRef="G3" targetRef="G3b" />
    <bpmn:sequenceFlow id="F14" name="No" sourceRef="G3" targetRef="T7" />
    <bpmn:sequenceFlow id="F15" sourceRef="T7" targetRef="G4" />
    <bpmn:sequenceFlow id="F16" sourceRef="G4" targetRef="IC_msg" />
    <bpmn:sequenceFlow id="F17" sourceRef="G4" targetRef="IC_t48" />
    <bpmn:sequenceFlow id="F18" sourceRef="IC_msg" targetRef="T7b" />
    <bpmn:sequenceFlow id="F19" sourceRef="T7b" targetRef="G3b" />
    <bpmn:sequenceFlow id="F20" sourceRef="IC_t48" targetRef="T8" />
    <bpmn:sequenceFlow id="F21" sourceRef="T8" targetRef="End_2" />
    <bpmn:sequenceFlow id="F22" sourceRef="G3b" targetRef="T9" />
    <bpmn:sequenceFlow id="F23" sourceRef="T9" targetRef="IC_t1" />
    <bpmn:sequenceFlow id="F24" sourceRef="IC_t1" targetRef="T10" />
    <bpmn:sequenceFlow id="F25" sourceRef="T10" targetRef="G5" />
    <bpmn:sequenceFlow id="F26" name="Sí" sourceRef="G5" targetRef="G5b" />
    <bpmn:sequenceFlow id="F27" name="No" sourceRef="G5" targetRef="T11" />
    <bpmn:sequenceFlow id="F28" sourceRef="T11" targetRef="IC_t2" />
    <bpmn:sequenceFlow id="F29" sourceRef="IC_t2" targetRef="T12" />
    <bpmn:sequenceFlow id="F30" sourceRef="T12" targetRef="G5b" />
    <bpmn:sequenceFlow id="F31" sourceRef="BE_err" targetRef="T13" />
    <bpmn:sequenceFlow id="F32" sourceRef="T13" targetRef="End_3" />
    <bpmn:sequenceFlow id="F33" sourceRef="G5b" targetRef="T14" />
    <bpmn:sequenceFlow id="F34" sourceRef="T14" targetRef="IC_t3" />
    <bpmn:sequenceFlow id="F35" sourceRef="IC_t3" targetRef="T15" />
    <bpmn:sequenceFlow id="F36" sourceRef="T15" targetRef="T16" />
    <bpmn:sequenceFlow id="F37" sourceRef="T16" targetRef="T17" />
    <bpmn:sequenceFlow id="F38" sourceRef="T17" targetRef="End_4" />
    <bpmn:textAnnotation id="Ann_Titulo"><bpmn:text>PROCESO AS IS: Atender solicitud de cita de mantenimiento preventivo
Autonorte Servicios Automotrices S.A.C.  ·  Grupo 4  ·  Automatizacion Inteligente de Procesos 202620</bpmn:text></bpmn:textAnnotation>
    <bpmn:textAnnotation id="Ann1"><bpmn:text>Mediana medida: 6 h 10 min
(muestra de 20 casos)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_Ann1" sourceRef="IC_t1" targetRef="Ann1" />
