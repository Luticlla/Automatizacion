<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Autonorte_TOBE" targetNamespace="http://upao.edu.pe/aip/g4" exporter="Grupo 4 AIP" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Part_Cliente" name="Cliente" processRef="Proc_Cliente" />
    <bpmn:participant id="Part_Autonorte" name="Autonorte Servicios Automotrices S.A.C. | Atender solicitud de cita de mantenimiento preventivo (TO BE)" processRef="Proc_1" />
    <bpmn:messageFlow id="MF1" name="Solicitud de cita" sourceRef="C_T1" targetRef="Start_1" />
    <bpmn:messageFlow id="MF2" name="Aviso de derivacion" sourceRef="S6d" targetRef="C_T2" />
    <bpmn:messageFlow id="MF3" name="Tres fechas alternativas" sourceRef="S9a" targetRef="C_T3" />
    <bpmn:messageFlow id="MF4" name="Fecha elegida" sourceRef="C_T5" targetRef="IC_msg" />
    <bpmn:messageFlow id="MF5" name="Confirmacion inmediata" sourceRef="S14c" targetRef="C_T6" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Cliente" name="Cliente" isExecutable="false">
    <bpmn:startEvent id="C_Start" name="Necesita mantenimiento preventivo">
      <bpmn:outgoing>CF1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="C_T1" name="Enviar la solicitud de cita">
      <bpmn:incoming>CF1</bpmn:incoming>
      <bpmn:outgoing>CF2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="C_GM" name="">
      <bpmn:incoming>CF2</bpmn:incoming>
      <bpmn:incoming>CF10</bpmn:incoming>
      <bpmn:outgoing>CF3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="C_G1" name="Espera la respuesta del sistema">
      <bpmn:incoming>CF3</bpmn:incoming>
      <bpmn:outgoing>CF4</bpmn:outgoing>
      <bpmn:outgoing>CF5</bpmn:outgoing>
      <bpmn:outgoing>CF6</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:receiveTask id="C_T2" name="Recibir el aviso de derivacion a reparaciones">
      <bpmn:incoming>CF4</bpmn:incoming>
      <bpmn:outgoing>CF11</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:receiveTask id="C_T3" name="Recibir las tres fechas alternativas">
      <bpmn:incoming>CF5</bpmn:incoming>
      <bpmn:outgoing>CF8</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:userTask id="C_T4" name="Elegir una de las fechas propuestas">
      <bpmn:incoming>CF8</bpmn:incoming>
      <bpmn:outgoing>CF9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="C_T5" name="Enviar la fecha elegida">
      <bpmn:incoming>CF9</bpmn:incoming>
      <bpmn:outgoing>CF10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:receiveTask id="C_T6" name="Recibir la confirmacion inmediata de la cita">
      <bpmn:incoming>CF6</bpmn:incoming>
      <bpmn:outgoing>CF13</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="C_End1" name="Cliente informado de la derivacion">
      <bpmn:incoming>CF11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="C_End2" name="Cliente con la cita confirmada">
      <bpmn:incoming>CF13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CF1" sourceRef="C_Start" targetRef="C_T1" />
    <bpmn:sequenceFlow id="CF2" sourceRef="C_T1" targetRef="C_GM" />
    <bpmn:sequenceFlow id="CF3" sourceRef="C_GM" targetRef="C_G1" />
    <bpmn:sequenceFlow id="CF4" sourceRef="C_G1" targetRef="C_T2" />
    <bpmn:sequenceFlow id="CF5" sourceRef="C_G1" targetRef="C_T3" />
    <bpmn:sequenceFlow id="CF6" sourceRef="C_G1" targetRef="C_T6" />
    <bpmn:sequenceFlow id="CF8" sourceRef="C_T3" targetRef="C_T4" />
    <bpmn:sequenceFlow id="CF9" sourceRef="C_T4" targetRef="C_T5" />
    <bpmn:sequenceFlow id="CF10" sourceRef="C_T5" targetRef="C_GM" />
    <bpmn:sequenceFlow id="CF11" sourceRef="C_T2" targetRef="C_End1" />
    <bpmn:sequenceFlow id="CF13" sourceRef="C_T6" targetRef="C_End2" />
  </bpmn:process>
  <bpmn:process id="Proc_1" name="Atender solicitud de cita de mantenimiento preventivo · TO BE" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S1v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3n</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S4d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S5c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S6d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S7c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S8k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AND2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_kit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S9q</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S9a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IC_t24</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S10d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_apr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S12r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_cls</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S14c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S13f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_cupo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_kit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BE_err</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Humano" name="Humano (excepciones)">
        <bpmn:flowNodeRef>H1r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H2d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3c</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H3k</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H5r</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>H4a</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BT_kit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="Solicitud de cita recibida (webhook)">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_1_def" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="S1v" name="Validar la solicitud contra el contrato de datos">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Cumple el contrato de datos">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S2c" name="Registrar en la cola de revision y responder 400">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="H1r" name="Corregir la solicitud en la cola de revision">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="Solicitud devuelta para correccion">
      <bpmn:incoming>F5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S3n" name="Normalizar los datos y calcular la clave de idempotencia">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S2b" name="Consultar la clave en el registro de citas">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="La clave ya existe">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S4d" name="Devolver la cita ya registrada">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S5c" name="Clasificar el servicio y estimar su duracion">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Es mantenimiento preventivo">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_2" name="Cita ya existente - respuesta 200">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S_rev" name="Encolar la solicitud para la revision del asesor">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="H2d" name="Resolver la clasificacion dudosa">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G3c" name="Que resolvio el asesor">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="S6d" name="Notificar al cliente la derivacion a taller correctivo">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="G3b" name="">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_3" name="Solicitud derivada a taller correctivo">
      <bpmn:incoming>F20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="AND1" name="">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="S7c" name="Consultar la disponibilidad de bahia y tecnico">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S8k" name="Verificar la existencia del kit en el sistema de almacen">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="AND2" name="">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="G4" name="Hay cupo y kit">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
      <bpmn:outgoing>F28</bpmn:outgoing>
      <bpmn:outgoing>F29</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_kit" name="Encolar el pedido del kit al proveedor">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S9q" name="Consultar las tres fechas alternativas disponibles">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="H3k" name="Gestionar el pedido del kit y acordar la fecha con el cliente">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="S9a" name="Proponer tres fechas alternativas al cliente">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="H5r" name="Reprogramar la cita con el cliente">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:eventBasedGateway id="G5" name="Elige fecha o vence el plazo">
      <bpmn:incoming>F34</bpmn:incoming>
      <bpmn:outgoing>F35</bpmn:outgoing>
      <bpmn:outgoing>F36</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:endEvent id="End_7" name="Cita reprogramada por falta de kit">
      <bpmn:incoming>F32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="IC_msg" name="El cliente elige una fecha">
      <bpmn:incoming>F35</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
      <bpmn:messageEventDefinition id="IC_msg_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="IC_t24" name="Vencen 24 horas sin respuesta">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
      <bpmn:timerEventDefinition id="IC_t24_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="S10d" name="Registrar la solicitud como desistida">
      <bpmn:incoming>F37</bpmn:incoming>
      <bpmn:outgoing>F38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4b" name="">
      <bpmn:incoming>F29</bpmn:incoming>
      <bpmn:incoming>F39</bpmn:incoming>
      <bpmn:incoming>F40</bpmn:incoming>
      <bpmn:outgoing>F41</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G6" name="La duracion estimada supera las 2 horas">
      <bpmn:incoming>F41</bpmn:incoming>
      <bpmn:outgoing>F42</bpmn:outgoing>
      <bpmn:outgoing>F44</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_4" name="Solicitud desistida">
      <bpmn:incoming>F38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S_apr" name="Encolar la aprobacion del jefe de taller">
      <bpmn:incoming>F42</bpmn:incoming>
      <bpmn:outgoing>F43</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="H4a" name="Aprobar la asignacion excepcional">
      <bpmn:incoming>F43</bpmn:incoming>
      <bpmn:outgoing>F45</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G6b" name="">
      <bpmn:incoming>F44</bpmn:incoming>
      <bpmn:incoming>F45</bpmn:incoming>
      <bpmn:outgoing>F46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S12r" name="Registrar la cita con restriccion de unicidad">
      <bpmn:incoming>F46</bpmn:incoming>
      <bpmn:outgoing>F47</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_cls" name="Clasificar el error y determinar su clase">
      <bpmn:incoming>F49</bpmn:incoming>
      <bpmn:incoming>F50</bpmn:incoming>
      <bpmn:incoming>F51</bpmn:incoming>
      <bpmn:incoming>F54</bpmn:incoming>
      <bpmn:outgoing>F52</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="S14c" name="Enviar la confirmacion inmediata al cliente">
      <bpmn:incoming>F47</bpmn:incoming>
      <bpmn:outgoing>F48</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_6" name="Cita confirmada - respuesta 201">
      <bpmn:incoming>F48</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="S13f" name="Registrar el caso en la cola de fallidos">
      <bpmn:incoming>F52</bpmn:incoming>
      <bpmn:outgoing>F53</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_5" name="Cita no registrada - caso en cola de fallidos">
      <bpmn:incoming>F53</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BE_cupo" name="La agenda no responde o devuelve error" attachedToRef="S7c">
      <bpmn:outgoing>F50</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BE_cupo_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_kit" name="El almacen no responde o devuelve error" attachedToRef="S8k">
      <bpmn:outgoing>F51</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BE_kit_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_alt" name="La agenda no responde al buscar alternativas" attachedToRef="S9q">
      <bpmn:outgoing>F54</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BE_alt_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BE_err" name="El destino rechaza o no responde" attachedToRef="S12r">
      <bpmn:outgoing>F49</bpmn:outgoing>
      <bpmn:errorEventDefinition id="BE_err_def" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BT_kit" name="Vencen 48 horas sin respuesta del proveedor" attachedToRef="H3k">
      <bpmn:outgoing>F31</bpmn:outgoing>
      <bpmn:timerEventDefinition id="BT_kit_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="S1v" />
    <bpmn:sequenceFlow id="F2" sourceRef="S1v" targetRef="G1" />
    <bpmn:sequenceFlow id="F3" name="No" sourceRef="G1" targetRef="S2c" />
    <bpmn:sequenceFlow id="F4" sourceRef="S2c" targetRef="H1r" />
    <bpmn:sequenceFlow id="F5" sourceRef="H1r" targetRef="End_1" />
    <bpmn:sequenceFlow id="F6" name="Si" sourceRef="G1" targetRef="S3n" />
    <bpmn:sequenceFlow id="F7" sourceRef="S3n" targetRef="S2b" />
    <bpmn:sequenceFlow id="F8" sourceRef="S2b" targetRef="G2" />
    <bpmn:sequenceFlow id="F9" name="Si" sourceRef="G2" targetRef="S4d" />
    <bpmn:sequenceFlow id="F10" sourceRef="S4d" targetRef="End_2" />
